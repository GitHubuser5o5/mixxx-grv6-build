+namespace {
+// GRV6: the columns of the fixed layout, in the order they appear: Color, #, Title, Artist,
+// BPM, Key, Rating, Duration. A column the model does not have (Tracks and crates have no #
+// column) is left out. Title, Artist and Duration are required; without all three the list
+// is empty and the model is not laid out.
+QList<int> fixedLayoutColumns(const TrackModel* pTrackModel) {
+    QList<int> columns;
+    for (const char* name : {"color", "position", "title", "artist", "bpm", "key", "rating", "duration"}) {
+        const int column = pTrackModel->fieldIndex(QString::fromLatin1(name));
+        if (column >= 0) {
+            columns.append(column);
+        }
+    }
+    for (const char* required : {"title", "artist", "duration"}) {
+        if (pTrackModel->fieldIndex(QString::fromLatin1(required)) < 0) {
+            return {};
+        }
+    }
+    return columns;
+}
+} // namespace
