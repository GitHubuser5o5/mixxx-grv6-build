+    // Tail window: let effects that declare EffectManifest::tailTimeMillis() > 0 (Echo,
+    // Reverb) keep ringing out after being disabled, instead of being cut off after this
+    // one callback like every other effect. This only reads/writes channelStatus.
+    // tailFramesRemaining; channelStatus.enableState and m_enableState, and every other
+    // enable/disable/fadeout path in this function, are computed exactly as in stock Mixxx.
+    bool feedSilenceThisCallback = false;
+    if (effectiveChainEnableState == EffectEnableState::Disabling) {
+        // Just became Disabling this callback (the same transitional signal Echo/Reverb
+        // used to hard-cut on): look up how long a tail the effects in this chain want.
+        unsigned int tailFrames = 0;
+        for (EngineEffect* pEffect : std::as_const(m_effects)) {
+            if (pEffect != nullptr) {
+                const double effectTailMillis = pEffect->getManifest()->tailTimeMillis();
+                if (effectTailMillis > 0) {
+                    const auto effectTailFrames = static_cast<unsigned int>(
+                            effectTailMillis / 1000.0 * sampleRate);
+                    tailFrames = std::max(tailFrames, effectTailFrames);
+                }
+            }
+        }
+        channelStatus.tailFramesRemaining = tailFrames;
+    } else if (channelStatus.tailFramesRemaining > 0 &&
+            effectiveChainEnableState == EffectEnableState::Disabled) {
+        // Genuinely disabled already (not Enabling/Enabled/Disabling, so this cannot
+        // interfere with the normal re-enable ramp): keep processing for the rest of the
+        // tail, with the dry signal FED INTO THE EFFECTS silenced below (so no new signal
+        // is fed into whatever is ringing) - but NOT the dry signal in the final mix, which
+        // must stay real: this is still an active, routed channel that should keep sounding
+        // normal, just with a decaying wet tail added on top. (Bug fixed here: an earlier
+        // version of this patch silenced both, which - since switching which channel a unit
+        // is focused on disables the previous channel's routing exactly the same way turning
+        // the unit off does - made a channel's own volume vanish for the whole tail window
+        // whenever FX focus moved away from it while an effect with a tail was loaded.)
+        effectiveChainEnableState = EffectEnableState::Enabled;
+        feedSilenceThisCallback = true;
+        const unsigned int framesThisCallback = numSamples / 2; // engine buffers are stereo
+        channelStatus.tailFramesRemaining -=
+                std::min(channelStatus.tailFramesRemaining, framesThisCallback);
+    }
+    // Only feeds the effect processors below, so a tail doesn't keep absorbing new signal.
+    // The final dry+wet mix further down uses the real pIn, never this.
+    CSAMPLE* pEffectFeedIn = feedSilenceThisCallback ? m_silentBuffer.data() : pIn;
+
     CSAMPLE currentMixKnob = m_dMix;
     CSAMPLE lastCallbackMixKnob = channelStatus.oldMixKnob;
 
