+namespace {
+Display* grv6OpenDisplay() {
+    const char* name = getenv("DISPLAY");
+    return XOpenDisplay(name ? name : ":0.0");
+}
+} // namespace
+
+void ScreenSaverHelper::grv6SetSleepTimeout(int seconds) {
+    Display* display = grv6OpenDisplay();
+    if (display == nullptr) {
+        return;
+    }
+    // interval 0: no cycling; blanking instead of a pattern.
+    XSetScreenSaver(display, seconds > 0 ? seconds : 0, 0, PreferBlanking, DefaultExposures);
+    XFlush(display);
+    XCloseDisplay(display);
+}
+
+void ScreenSaverHelper::grv6SleepNow() {
+    Display* display = grv6OpenDisplay();
+    if (display == nullptr) {
+        return;
+    }
+    XForceScreenSaver(display, ScreenSaverActive);
+    XFlush(display);
+    XCloseDisplay(display);
+}
