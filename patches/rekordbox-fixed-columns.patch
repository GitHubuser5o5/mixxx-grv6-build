+void WTrackTableView::applyFixedColumnWidths() {
+    TrackModel* pTrackModel = getTrackModel();
+    if (!pTrackModel || !pTrackModel->fixedColumnLayout()) {
+        return;
+    }
+    const int posColumn = pTrackModel->fieldIndex(QStringLiteral("position"));
+    const int artistColumn = pTrackModel->fieldIndex(QStringLiteral("artist"));
+    const int titleColumn = pTrackModel->fieldIndex(QStringLiteral("title"));
+    const int keyColumn = pTrackModel->fieldIndex(QStringLiteral("key"));
+    const int durationColumn = pTrackModel->fieldIndex(QStringLiteral("duration"));
+    if (posColumn < 0 || artistColumn < 0 || titleColumn < 0 ||
+            keyColumn < 0 || durationColumn < 0) {
+        return;
+    }
+
+    // Visual order: #, Title, Artist, Key, Duration.
+    QHeaderView* pHeader = horizontalHeader();
+    const int logicalOrder[] = {
+            posColumn, titleColumn, artistColumn, keyColumn, durationColumn};
+    int visualTarget = 0;
+    for (const int logical : logicalOrder) {
+        const int visual = pHeader->visualIndex(logical);
+        if (visual >= 0 && visual != visualTarget) {
+            pHeader->moveSection(visual, visualTarget);
+        }
+        ++visualTarget;
+    }
+
+    const int viewportWidth = viewport()->width();
+    if (viewportWidth <= 0) {
+        return;
+    }
+    const QFontMetrics metrics(font());
+    // Content-sized columns: # plus sort arrow, key names, m:ss durations.
+    const int posWidth = metrics.horizontalAdvance(QStringLiteral("9999")) + 24;
+    const int keyWidth = metrics.horizontalAdvance(QStringLiteral("A#m")) + 24;
+    const int durationWidth =
+            metrics.horizontalAdvance(QStringLiteral("88:88")) + 16;
+    int remaining = viewportWidth - posWidth - keyWidth - durationWidth;
+    if (remaining < 120) {
+        remaining = 120;
+    }
+    // Artist/Title share the rest 40/60.
+    const int artistWidth = remaining * 2 / 5;
+    const int titleWidth = remaining - artistWidth;
+    setColumnWidth(posColumn, posWidth);
+    setColumnWidth(titleColumn, titleWidth);
+    setColumnWidth(artistColumn, artistWidth);
+    setColumnWidth(keyColumn, keyWidth);
+    // durationColumn is the last visual section and stretches to fill
+    // the remaining width (setStretchLastSection in loadTrackModel).
+}
