+// Pioneered: resolve a track path whose accented characters may be stored in
+// the PDB in a different Unicode normalisation form than the one the
+// filesystem hands back. rekordbox on macOS writes decomposed (NFD) names to
+// FAT32 while the PDB string can be composed (NFC), or vice versa on Windows,
+// and a byte-exact lookup then misses a file that is plainly on the stick --
+// the load silently does nothing. Only paths with non-ASCII characters can be
+// affected, so the extra stat() is paid only for those; an ASCII path is
+// returned untouched without touching the disk.
+QString resolveUnicodePath(const QString& path) {
+    bool ascii = true;
+    for (const QChar& c : path) {
+        if (c.unicode() > 0x7f) {
+            ascii = false;
+            break;
+        }
+    }
+    if (ascii || QFile::exists(path)) {
+        return path;
+    }
+    const QString nfc = path.normalized(QString::NormalizationForm_C);
+    if (nfc != path && QFile::exists(nfc)) {
+        return nfc;
+    }
+    const QString nfd = path.normalized(QString::NormalizationForm_D);
+    if (nfd != path && QFile::exists(nfd)) {
+        return nfd;
+    }
+    return path;
+}
