+bool WTrackTableView::viewportEvent(QEvent* event) {
+    const bool handled = WLibraryTableView::viewportEvent(event);
+    // GRV6: the viewport changes size without this widget being resized when the
+    // vertical scroll bar appears or disappears. The rows arrive after the columns
+    // were first sized, so the scroll bar usually shows up later and takes its
+    // width from the viewport; the last column (Duration) then ended under the bar
+    // and its last digits were clipped. Fit the fixed columns to the new width.
+    if (event->type() == QEvent::Resize && !m_applyingFixedColumnWidths) {
+        m_applyingFixedColumnWidths = true;
+        applyFixedColumnWidths();
+        m_applyingFixedColumnWidths = false;
+    }
+    return handled;
+}
