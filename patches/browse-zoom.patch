+
+void Library::slotVisibleRowsControlChanged(double value) {
+    // 0 (off) is valid too - see getTrackTableVisibleRows()'s doc comment.
+    const int visibleRows = std::clamp(static_cast<int>(value), 0, 20);
+    setVisibleRows(visibleRows);
+    // Reflects the clamped value back, and re-confirms the CO's own value even
+    // when a rejected write (out of range, or a no-op repeat) would otherwise
+    // leave it unconfirmed.
+    m_pVisibleRowsControl->setAndConfirm(visibleRows);
+}
