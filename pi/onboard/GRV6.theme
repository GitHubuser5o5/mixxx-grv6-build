<?xml version="1.0" ?>
<!-- Onboard theme "GRV6": flat, dark keys, Inter, orange when pressed. Colours are in GRV6.colors. -->
<theme format="1.3" name="GRV6">
  <color_scheme>GRV6</color_scheme>
  <background_gradient>0.0</background_gradient>
  <key_style>flat</key_style>
  <roundrect_radius>12.0</roundrect_radius>
  <key_size>100.0</key_size>
  <key_stroke_width>1.0</key_stroke_width>
  <key_label_font>Inter</key_label_font>
  <key_label_overrides/>
  <key_shadow_strength>0.0</key_shadow_strength>
  <key_shadow_size>0.0</key_shadow_size>
</theme>
