  <ObjectName>Mixxx</ObjectName>
  <MinimumSize>1280,720</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>

  <!-- Splash screen while Mixxx starts: put the logo in images/logo.png (any size up to about 900x300). -->
  <LaunchImageStyle>
    QLabel {
      image: url(skin:/images/logo.png);
      margin-bottom: 16px;
    }
    QProgressBar {
      background-color: #15161a;
      max-height: 4px;
    }
    QProgressBar::chunk {
      background-color: #d2670f;
    }
  </LaunchImageStyle>

  <Children>
    <WidgetGroup>
      <ObjectName>SkinRoot</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Children>

        <!-- Track-load error banner. Needs the stable 2 patch build (mixxx-build/patches/load-failed-banner.patch);
             on stock Mixxx [Library],load_error is never set, so this stays hidden forever, harmlessly. -->
        <WidgetGroup>
          <ObjectName>ErrorBanner</ObjectName>
          <Layout>horizontal</Layout>
          <SizePolicy>me,f</SizePolicy>
          <MinimumSize>0,50</MinimumSize>
          <MaximumSize>-1,50</MaximumSize>
          <Connection>
            <ConfigKey>[Library],load_error</ConfigKey>
            <BindProperty>visible</BindProperty>
          </Connection>
          <Children>
            <Label>
              <ObjectName>ErrorBannerText</ObjectName>
              <Text>TRACK NOT FOUND - check the USB - press BACK to dismiss</Text>
              <SizePolicy>me,me</SizePolicy>
            </Label>
          </Children>
        </WidgetGroup>

        <!-- Any other Mixxx error (originally a popup nothing could dismiss). Needs the stable 2 patch build
             (mixxx-build/patches/error-dialog-banner.patch); on stock Mixxx [Library],app_error is never set,
             so this stays hidden forever, harmlessly. The real message goes to mixxx.log, not on screen, since
             a skin control can't carry text - press BACK to dismiss and check the log if it recurs. -->
        <WidgetGroup>
          <ObjectName>ErrorBanner</ObjectName>
          <Layout>horizontal</Layout>
          <SizePolicy>me,f</SizePolicy>
          <MinimumSize>0,50</MinimumSize>
          <MaximumSize>-1,50</MaximumSize>
          <Connection>
            <ConfigKey>[Library],app_error</ConfigKey>
            <BindProperty>visible</BindProperty>
          </Connection>
          <Children>
            <Label>
              <ObjectName>ErrorBannerText</ObjectName>
              <Text>MIXXX ERROR - see mixxx.log - press BACK to dismiss</Text>
              <SizePolicy>me,me</SizePolicy>
            </Label>
          </Children>
        </WidgetGroup>

        <Template src="skin:topbar.xml"/>

        <WidgetStack currentpage="[Skin],grv6_tab">
          <SizePolicy>me,me</SizePolicy>
          <Children>
            <WidgetGroup trigger="[Skin],grv6_show_main">
              <ObjectName>Transparent</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>
                <Template src="skin:main.xml"/>
              </Children>
            </WidgetGroup>
            <WidgetGroup trigger="[Skin],show_maximized_library" on_hide_select="0">
              <ObjectName>Transparent</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>
                <Template src="skin:browse.xml"/>
              </Children>
            </WidgetGroup>
            <WidgetGroup trigger="[Skin],grv6_show_sampler" on_hide_select="0">
              <ObjectName>Transparent</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>
                <Template src="skin:sampler_page.xml"/>
              </Children>
            </WidgetGroup>
            <WidgetGroup trigger="[Skin],grv6_show_settings" on_hide_select="0">
              <ObjectName>Transparent</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>
                <Template src="skin:settings.xml"/>
              </Children>
            </WidgetGroup>
          </Children>
        </WidgetStack>

      </Children>
    </WidgetGroup>
