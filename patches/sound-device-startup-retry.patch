+    // Sound hardware setup.
+    // GRV6 kiosk build: this rig has no keyboard, mouse or touchscreen, so the stock
+    // Retry/Reconfigure/Help/Exit dialogs below (soundDeviceBusyDlg, soundDeviceErrorMsgDlg,
+    // noOutputDlg - now unused but left in place) could never be dismissed here: on a cold
+    // boot where the audio interface has not finished enumerating yet, Mixxx would simply
+    // hang before the skin or any control is even usable. Retry a few times with a short
+    // delay instead - the interface may just need a moment - and if it is still not working,
+    // exit(0) so the kiosk's restart loop (~/.xinitrc) gives it another try shortly, rather
+    // than hanging here indefinitely. This only affects startup; a device lost mid-session
+    // goes through SoundManager's own runtime handling, a different code path untouched here.
+    constexpr int kSoundDeviceMaxAttempts = 6;
+    constexpr int kSoundDeviceRetryDelayMillis = 1000;
+    SoundDeviceStatus result = m_pCoreServices->getSoundManager()->setupDevices();
+    for (int attempt = 2;
+            result != SoundDeviceStatus::Ok && attempt <= kSoundDeviceMaxAttempts;
+            ++attempt) {
+        qWarning() << "Sound device setup failed, status" << static_cast<int>(result)
+                   << "- retrying (attempt" << attempt << "of" << kSoundDeviceMaxAttempts
+                   << ") in" << kSoundDeviceRetryDelayMillis << "ms";
+        QThread::msleep(kSoundDeviceRetryDelayMillis);
+        m_pCoreServices->getSoundManager()->clearAndQueryDevices();
+        result = m_pCoreServices->getSoundManager()->setupDevices();
+    }
+    if (result != SoundDeviceStatus::Ok) {
+        qWarning() << "Sound device setup still failing after" << kSoundDeviceMaxAttempts
+                   << "attempts (status" << static_cast<int>(result)
+                   << ") - exiting so the kiosk restart loop (~/.xinitrc) can try again.";
+        exit(0);
+    }
 
