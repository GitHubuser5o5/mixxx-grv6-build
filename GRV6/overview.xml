<!DOCTYPE template>
<!--
  Overview waveform of one deck. Variable: channel (1-4).

  "Half" overview: Mixxx only draws the overview mirrored around a centre line. The widget is made twice as high as
  the visible area and put in a group that clips it, so only the upper half shows (bars rise from the bottom edge).
  The group has no layout, so the overview is placed by <Pos>; its width (1792) is the width of the wave area at 1920x1080.
  Colours: none set, so the overview follows the type chosen in Preferences > Waveforms (RGB = normal RGB waveform).
-->
<Template>
  <WidgetGroup>
    <ObjectName>OverviewClip</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <Overview>
        <ObjectName>Overview</ObjectName>
        <TooltipId>waveform_overview</TooltipId>
        <Channel><Variable name="channel"/></Channel>
        <Pos>0,0</Pos>
        <Size>1792f,124f</Size>
        <BgColor><Variable name="ov_bg"/></BgColor>
        <AxesColor>#00000000</AxesColor>
        <PlayPosColor><Variable name="ov_playpos"/></PlayPosColor>
        <PlayedOverlayColor><Variable name="ov_played"/></PlayedOverlayColor>
        <MinuteMarkerColor><Variable name="ov_minute"/></MinuteMarkerColor>
        <LabelFontSize>15</LabelFontSize>
        <SignalColor>#007BCD</SignalColor>
        <SignalHighColor></SignalHighColor>
        <SignalMidColor></SignalMidColor>
        <SignalLowColor></SignalLowColor>
        <SignalRGBHighColor></SignalRGBHighColor>
        <SignalRGBMidColor></SignalRGBMidColor>
        <SignalRGBLowColor></SignalRGBLowColor>
        <Mark><Control>cue_point</Control><Text>CUE</Text><Color>#d2670f</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_1_position</Control><Text>1</Text><Color>#f44040</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_2_position</Control><Text>2</Text><Color>#0ddcf2</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_3_position</Control><Text>3</Text><Color>#a5df13</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_4_position</Control><Text>4</Text><Color>#9d4cfd</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_5_position</Control><Text>5</Text><Color>#3fec2b</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_6_position</Control><Text>6</Text><Color>#e6681c</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_7_position</Control><Text>7</Text><Color>#2749c8</Color><TextColor>#ffffff</TextColor><Align>top</Align></Mark>
        <Mark><Control>hotcue_8_position</Control><Text>8</Text><Color>#c7b205</Color><TextColor>#0a0a0b</TextColor><Align>top</Align></Mark>
        <Mark><Control>loop_start_position</Control><Color>#d2670f</Color></Mark>
        <Mark><Control>loop_end_position</Control><Color>#d2670f</Color></Mark>
        <MarkRange>
          <StartControl>loop_start_position</StartControl>
          <EndControl>loop_end_position</EndControl>
          <EnabledControl>loop_enabled</EnabledControl>
          <Color>#d2670f</Color>
          <Opacity>0.5</Opacity>
          <DisabledColor>#71747b</DisabledColor>
          <DisabledOpacity>0.25</DisabledOpacity>
        </MarkRange>
        <Connection>
          <ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey>
        </Connection>
      </Overview>
    </Children>
  </WidgetGroup>
</Template>
