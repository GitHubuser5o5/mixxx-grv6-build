 // static
+QString KeyUtils::keyToGrvString(ChromaticKey key) {
+    if (!ChromaticKey_IsValid(key) ||
+            key == mixxx::track::io::key::INVALID) {
+        return {};
+    }
+    switch (s_grvKeyStyle.load(std::memory_order_relaxed)) {
+    case 1:
+        return s_grvSharpKeyNames[static_cast<int>(key)];
+    case 2:
+        return s_grvFlatKeyNames[static_cast<int>(key)];
+    default:
+        return keyToString(key, KeyNotation::Lancelot);
+    }
+}
+
+// static
+void KeyUtils::setGrvKeyStyle(bool traditional, bool flats) {
+    s_grvKeyStyle.store(traditional ? (flats ? 2 : 1) : 0, std::memory_order_relaxed);
+}
