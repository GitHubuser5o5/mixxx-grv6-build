 namespace {
 
+// GRV6: the Key column's delegate. The traffic light (the green Key cell of a track that is
+// compatible with the master deck) is the cell's Qt::BackgroundRole, but a selected row is
+// painted with the stylesheet's selection colour over it, hiding the traffic light exactly on
+// the row you are looking at. A cell that has a background of its own is therefore drawn as if
+// it were not selected. No Q_OBJECT: nothing here needs the meta object system.
+class GrvKeyDelegate : public QStyledItemDelegate {
+  public:
+    explicit GrvKeyDelegate(QObject* pParent)
+            : QStyledItemDelegate(pParent) {
+    }
+
+    void initStyleOption(QStyleOptionViewItem* pOption, const QModelIndex& index) const override {
+        QStyledItemDelegate::initStyleOption(pOption, index);
+        if (index.data(Qt::BackgroundRole).isValid()) {
+            pOption->state &= ~QStyle::State_Selected;
+        }
+    }
+};
