<!DOCTYPE skin>
<!-- GENERATED by tools/build_skin.py -->
<skin>
  <manifest>
    <title>GRV6</title>
    <author>GitHubuser5o5</author>
    <version>0.11</version>
    <description>Two-deck-at-a-time skin for a DDJ-GRV6 rig (4 decks, 1920x1080).</description>
    <language>en</language>
    <license>GPL-3.0-or-later</license>
    <attributes>
      <attribute config_key="[App],num_decks">4</attribute>
      <attribute config_key="[App],num_samplers">16</attribute>
      <attribute config_key="[App],num_preview_decks">1</attribute>

      <!-- Deck pair on screen. Not persistent: every skin load starts with left = deck 1, right = deck 2. -->
      <attribute config_key="[Skin],grv6_left_deck">1</attribute>
      <attribute config_key="[Skin],grv6_right_deck">2</attribute>
      <!-- Reserved for the beat-length readout (0-9), not displayed yet. -->
      <attribute config_key="[Skin],grv6_fx_beat">0</attribute>

      <!-- Time display: remaining, as mm:ss (Traditional Coarse). Same as Preferences > Decks, set here so it always holds. -->
      <attribute config_key="[Controls],ShowDurationRemaining">1</attribute>
      <attribute config_key="[Controls],TimeFormat">1</attribute>

      <!-- Tap on the time toggles TIME <-> REMAIN (see time_number.xml). 1 = remaining, same as ShowDurationRemaining above. -->
      <attribute config_key="[Skin],grv6_time_remain">1</attribute>
      <!-- 1 while the Browse info block shows a valid preview-deck track. INFO/PREVIEW set it, the controller's browse knob clears it. -->
      <attribute config_key="[Skin],grv6_info_valid">0</attribute>

      <!-- Tabs. grv6_tab = index of the shown page (0 Main, 1 Browse, 2 Sampler, 3 Settings); the show_ controls are the page triggers. -->
      <attribute config_key="[Skin],grv6_tab">0</attribute>
      <attribute config_key="[Skin],grv6_show_main">1</attribute>
      <attribute config_key="[Skin],show_maximized_library">0</attribute>
      <attribute config_key="[Skin],grv6_show_sampler">0</attribute>
      <attribute config_key="[Skin],grv6_show_settings">0</attribute>

      <!-- Settings tab. persist="true" = saved in mixxx.cfg (written when Mixxx exits cleanly, e.g. Ctrl+Q) and
           restored on the next start; the value here is only the first-run default. The controller script and the
           Settings page read/write these. All are plain 0/1 switches. -->
      <!-- Hot cue on a paused deck: 0 = jump and keep playing, 1 = gate (plays only while held, then back to the cue). -->
      <attribute config_key="[Skin],grv6_set_hotcue_gate" persist="true">0</attribute>
      <!-- Pressing a LOAD button stops the preview deck. -->
      <attribute config_key="[Skin],grv6_set_stop_preview" persist="true">0</attribute>
      <!-- Pressing a LOAD button while on the Browse tab goes back to the Main tab. -->
      <attribute config_key="[Skin],grv6_set_close_browse" persist="true">0</attribute>

      <!-- Set by Mixxx (stable 2 patch build only, see mixxx-build/patches/load-failed-banner.patch) when a
           track fails to load (e.g. its USB was pulled). Cleared by the controller's BACK button. -->
      <attribute config_key="[Library],load_error">0</attribute>
      <!-- Set by Mixxx (stable 2 patch build only, see mixxx-build/patches/error-dialog-banner.patch) for any
           other error that would otherwise show an undismissable popup. Cleared by the controller's BACK button. -->
      <attribute config_key="[Library],app_error">0</attribute>
    </attributes>
  </manifest>

