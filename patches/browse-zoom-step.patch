+    // GRV6: +/- push buttons for the Settings tab's browse text size stepper (a
+    // skin button can only write 1, never "set to 8"). Same 3-20 range as the
+    // controller's shift + browse knob, which writes grv6_visible_rows directly.
+    const auto makeVisibleRowsStep = [this](QScopedPointer<ControlPushButton>* pButton,
+                                             const QString& item,
+                                             int delta) {
+        pButton->reset(new ControlPushButton(ConfigKey(kConfigGroup, item)));
+        connect(pButton->data(),
+                &ControlObject::valueChanged,
+                this,
+                [this, delta](double value) {
+                    if (value > 0.0) {
+                        slotVisibleRowsControlChanged(
+                                std::clamp(m_iTrackTableVisibleRows + delta, 3, 20));
+                    }
+                });
+    };
+    makeVisibleRowsStep(&m_pVisibleRowsUp, QStringLiteral("grv6_visible_rows_up"), 1);
+    makeVisibleRowsStep(&m_pVisibleRowsDown, QStringLiteral("grv6_visible_rows_down"), -1);
