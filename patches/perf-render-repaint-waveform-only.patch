@@ -2,6 +2,7 @@
 
 #include <QPainter>
 
+#include <iterator>
 #include <utility>
 
 #include "track/track.h"
@@ -93,10 +94,17 @@ void WaveformRenderBeat::draw(QPainter* painter, QPaintEvent* /*event*/) {
     // XDJ: rekordbox-style bar markers. The first beat marker is anchored on
     // a downbeat by the rekordbox importer, so every 4th beat from it starts
     // a bar.
+    //
+    // The index of the first drawn beat relative to the marker is computed
+    // once here and then simply incremented in the loop. mixxx::Beats'
+    // const_iterator is not guaranteed to be random-access, so `it -
+    // firstMarker` can degrade to std::distance() -- an O(n) walk. Doing it
+    // per beat made that O(n^2) per frame on long tracks.
     const auto firstMarker = trackBeats->cfirstmarker();
-    QVector<float> downbeatXs;
+    int beatIndexFromMarker = static_cast<int>(std::distance(firstMarker, it));
+    m_downbeatXs.clear();
 
-    for (; it != trackBeats->cend() && *it <= endPosition; ++it) {
+    for (; it != trackBeats->cend() && *it <= endPosition; ++it, ++beatIndexFromMarker) {
         double beatPosition = it->toEngineSamplePos();
         double xBeatPoint =
                 m_waveformRenderer->transformSamplePositionInRendererWorld(beatPosition);
@@ -109,9 +117,8 @@ void WaveformRenderBeat::draw(QPainter* painter, QPaintEvent* /*event*/) {
         }
 
         if (orientation == Qt::Horizontal) {
-            const int beatIndexFromMarker = it - firstMarker;
             if (((beatIndexFromMarker % 4) + 4) % 4 == 0) {
-                downbeatXs.append(static_cast<float>(xBeatPoint));
+                m_downbeatXs.append(static_cast<float>(xBeatPoint));
             }
             m_beats[beatCount++].setLine(xBeatPoint, 0.0f, xBeatPoint, rendererHeight);
         } else {
@@ -124,24 +131,28 @@ void WaveformRenderBeat::draw(QPainter* painter, QPaintEvent* /*event*/) {
 
     // XDJ: draw small red triangles at the top and bottom of the waveform on
     // the first beat of each bar, like rekordbox/CDJ beatgrids.
-    if (!downbeatXs.isEmpty()) {
+    //
+    // All triangles go into one QPainterPath and are filled with a single
+    // drawPath(). The previous version issued two drawPolygon() rasterisations
+    // per downbeat, which on a Pi's software QPainter path meant dozens of
+    // separate fills per waveform per frame.
+    if (!m_downbeatXs.isEmpty()) {
         const float markerSize = std::max(4.0f, rendererHeight * 0.07f);
         const QColor barMarkerColor(0xE7, 0x1E, 0x27); // Pioneer red
         painter->setPen(Qt::NoPen);
         painter->setBrush(barMarkerColor);
-        for (const float x : std::as_const(downbeatXs)) {
-            const QPointF top[3] = {
-                    QPointF(x - markerSize, 0.0f),
-                    QPointF(x + markerSize, 0.0f),
-                    QPointF(x, markerSize),
-            };
-            const QPointF bottom[3] = {
-                    QPointF(x - markerSize, rendererHeight),
-                    QPointF(x + markerSize, rendererHeight),
-                    QPointF(x, rendererHeight - markerSize),
-            };
-            painter->drawPolygon(top, 3);
-            painter->drawPolygon(bottom, 3);
+        // clear() keeps the path's already-allocated element buffer.
+        m_downbeatPath.clear();
+        for (const float x : std::as_const(m_downbeatXs)) {
+            m_downbeatPath.moveTo(x - markerSize, 0.0f);
+            m_downbeatPath.lineTo(x + markerSize, 0.0f);
+            m_downbeatPath.lineTo(x, markerSize);
+            m_downbeatPath.closeSubpath();
+            m_downbeatPath.moveTo(x - markerSize, rendererHeight);
+            m_downbeatPath.lineTo(x + markerSize, rendererHeight);
+            m_downbeatPath.lineTo(x, rendererHeight - markerSize);
+            m_downbeatPath.closeSubpath();
         }
+        painter->drawPath(m_downbeatPath);
     }
 }
