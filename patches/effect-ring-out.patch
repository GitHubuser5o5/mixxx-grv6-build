+    /// How long, in milliseconds, this effect should keep being processed
+    /// (fed silence instead of the real input) after being disabled, so any
+    /// tail already in flight - a delay repeat, a reverb decay - can ring
+    /// out naturally instead of being cut off after one audio callback.
+    /// 0 (the default) keeps the original instant-cutoff behaviour.
+    double tailTimeMillis() const {
+        return m_tailTimeMillis;
+    }
+    void setTailTimeMillis(double tailTimeMillis) {
+        m_tailTimeMillis = tailTimeMillis;
